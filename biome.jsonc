{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "overrides": [
    {
      "includes": ["packages/backend/convex/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useAtIndex": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/shared/components/ui/**/*",
        "apps/web/src/features/*/index.ts",
        "apps/web/src/features/*/lib/index.ts",
        "apps/desktop/src/shared/components/ui/**/*"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off",
            "useAriaPropsForRole": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "noLabelWithoutControl": "off",
            "noRedundantRoles": "off"
          },
          "performance": {
            "noNamespaceImport": "off",
            "noBarrelFile": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": "off",
            "useBlockStatements": "off",
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off",
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
