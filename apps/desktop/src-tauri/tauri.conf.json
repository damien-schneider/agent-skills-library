{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Library",
  "mainBinaryName": "agents-library-desktop",
  "version": "0.0.1",
  "identifier": "dev.agents-library.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agents Library",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRTkyRUQwRTYzOUMwNDEKUldSQndEbm0wQzdwVHVOdjdRa1lwa2Rxb2R4ckM0NmcvVElqOFpnS0xtRHBuTzZxSXkzQzBtM1cK",
      "endpoints": [
        "https://github.com/damien-schneider/agent-skills-library/releases/latest/download/latest.json"
      ]
    }
  }
}
